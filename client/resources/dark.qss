/* Kairos — Dark theme */

QWidget {
    background-color: #1E1F22;
    color: #E8E9EB;
    font-size: 10pt;
}

QMainWindow, QDialog {
    background-color: #1E1F22;
}

QLabel {
    background: transparent;
}

QLabel[muted="true"] {
    color: #9AA0A6;
}

/* --- Buttons --- */
QPushButton {
    background-color: #2A2C31;
    border: 1px solid #3A3D44;
    border-radius: 6px;
    padding: 6px 14px;
    color: #E8E9EB;
}

QPushButton:hover {
    background-color: #34363C;
}

QPushButton:pressed {
    background-color: #3A4A73;
}

QPushButton:disabled {
    color: #6B6F76;
    background-color: #242529;
    border-color: #2E3036;
}

QPushButton[primary="true"] {
    background-color: #5B8DEF;
    border: 1px solid #5B8DEF;
    color: #0F1115;
    font-weight: 600;
}

QPushButton[primary="true"]:hover {
    background-color: #7AA2F7;
    border-color: #7AA2F7;
}

QPushButton[primary="true"]:disabled {
    background-color: #3A4A73;
    border-color: #3A4A73;
    color: #7C8699;
}

/* --- Inputs --- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #2A2C31;
    border: 1px solid #3A3D44;
    border-radius: 6px;
    padding: 5px 8px;
    selection-background-color: #5B8DEF;
    selection-color: #0F1115;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #5B8DEF;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* --- Lists --- */
QListWidget {
    background-color: #2A2C31;
    border: 1px solid #3A3D44;
    border-radius: 8px;
    outline: none;
}

QListWidget::item {
    padding: 8px 10px;
    border-radius: 6px;
    margin: 2px 4px;
}

QListWidget::item:hover {
    background-color: #34363C;
}

QListWidget::item:selected {
    background-color: #3A4A73;
    color: #E8E9EB;
}

QListWidget#navList {
    background-color: #2A2C31;
    border: none;
    border-right: 1px solid #3A3D44;
}

QListWidget#navList::item {
    padding: 10px 12px;
    margin: 2px 8px;
}

QListWidget#navList::item:selected {
    background-color: #5B8DEF;
    color: #0F1115;
    font-weight: 600;
}

/* --- Group boxes / cards --- */
QGroupBox {
    background-color: #2A2C31;
    border: 1px solid #3A3D44;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #E8E9EB;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #3A3D44;
    border-radius: 8px;
    background-color: #2A2C31;
}

QTabBar::tab {
    background-color: transparent;
    padding: 8px 16px;
    color: #9AA0A6;
}

QTabBar::tab:selected {
    color: #7AA2F7;
    font-weight: 600;
    border-bottom: 2px solid #7AA2F7;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #3A3D44;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #4A4D56;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* --- Server tiles (client/views/server_tile.py) --- */
QFrame#serverTile {
    background-color: #2A2C31;
    border: 1px solid #3A3D44;
    border-radius: 10px;
}

QFrame#serverTile:hover {
    border: 1px solid #5B8DEF;
    background-color: #34363C;
}

QLabel#serverTileName {
    font-weight: 600;
    font-size: 11pt;
}

/* --- Calendar --- */
QCalendarWidget {
    background-color: #2A2C31;
}

QCalendarWidget QToolButton {
    color: #E8E9EB;
}

/* --- Dashboard --- */
QLabel#statValue {
    font-size: 20pt;
    font-weight: bold;
}

QLabel#clockTime {
    font-size: 28pt;
    font-weight: 600;
    color: #7AA2F7;
}

/* --- Chat --- */
QLabel#chatThreadTitle {
    font-size: 13pt;
    font-weight: 600;
}
